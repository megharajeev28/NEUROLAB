// ============================================================
// NEURO LAB - SIMPLE INTERACTIVE GUI
// ============================================================

global NEUROLAB_HANDLES;
global NEUROLAB_MODEL;

function create_neurolab_gui()
    global NEUROLAB_HANDLES;
    global NEUROLAB_MODEL;

    NEUROLAB_MODEL = struct();

    f = figure("figure_name","NEURO LAB - Interactive Neural Network", ...
               "position",[50 40 1450 850], ...
               "background",[0.05 0.06 0.10], ...
               "resize","on");

    // ---------------- LEFT CONTROL PANEL ----------------
    uicontrol(f,"style","text","string","NEURO LAB", ...
        "position",[30 775 330 45],"fontsize",24,"fontweight","bold", ...
        "foreground",[0.2 0.9 1],"background",[0.05 0.06 0.10]);

    uicontrol(f,"style","text","string","Interactive AI Neural Network", ...
        "position",[30 745 330 25],"fontsize",11, ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    uicontrol(f,"style","text","string","DATASET", ...
        "position",[30 690 120 25],"fontsize",11,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);
    dataset_menu = uicontrol(f,"style","popupmenu","string",["XOR" "AND" "OR"], ...
        "position",[30 650 300 40],"fontsize",12);

    uicontrol(f,"style","text","string","LEARNING RATE", ...
        "position",[30 610 160 25],"fontsize",11,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);
    learning_rate_input = uicontrol(f,"style","edit","string","0.5", ...
        "position",[30 570 300 40],"fontsize",12,"background",[1 1 1],"foreground",[0 0 0]);

    uicontrol(f,"style","text","string","EPOCHS", ...
        "position",[30 530 160 25],"fontsize",11,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);
    epochs_input = uicontrol(f,"style","edit","string","3000", ...
        "position",[30 490 300 40],"fontsize",12,"background",[1 1 1],"foreground",[0 0 0]);

    uicontrol(f,"style","text","string","HIDDEN NEURONS", ...
        "position",[30 450 180 25],"fontsize",11,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);
    hidden_input = uicontrol(f,"style","edit","string","4", ...
        "position",[30 410 300 40],"fontsize",12,"background",[1 1 1],"foreground",[0 0 0]);

    train_button = uicontrol(f,"style","pushbutton","string","TRAIN NETWORK", ...
        "position",[30 340 300 55],"fontsize",13,"fontweight","bold", ...
        "background",[0.2 0.85 0.45],"foreground",[0 0 0]);

    reset_button = uicontrol(f,"style","pushbutton","string","RESET", ...
        "position",[30 275 300 45],"fontsize",12, ...
        "background",[0.85 0.85 0.85],"foreground",[0 0 0]);

    inspect_button = uicontrol(f,"style","pushbutton","string","INSPECT NETWORK", ...
        "position",[30 215 300 45],"fontsize",12, ...
        "background",[0.45 0.55 1],"foreground",[1 1 1]);

    math_button = uicontrol(f,"style","pushbutton","string","SHOW MATHEMATICS", ...
        "position",[30 155 300 45],"fontsize",12, ...
        "background",[0.65 0.35 0.95],"foreground",[1 1 1]);

    // ---------------- CENTER: TWO LARGE BOXES ----------------
    uicontrol(f,"style","text","string","TRAINING LOSS GRAPH", ...
        "position",[365 775 520 30],"fontsize",14,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    loss_frame = uicontrol(f,"style","frame","position",[350 420 560 350], ...
        "background",[0.12 0.13 0.19]);
    loss_axes = newaxes(loss_frame);
    loss_axes.axes_bounds = [0.12 0.16 0.82 0.72];
    loss_axes.background = [0.08 0.09 0.13];

    uicontrol(f,"style","text","string","NEURAL NETWORK FLOW", ...
        "position",[365 380 520 30],"fontsize",14,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    network_frame = uicontrol(f,"style","frame","position",[350 40 560 330], ...
        "background",[0.12 0.13 0.19]);
    network_axes = newaxes(network_frame);
    network_axes.axes_bounds = [0.06 0.10 0.88 0.78];
    network_axes.background = [0.08 0.09 0.13];

    // ---------------- RIGHT: RESULTS ----------------
    uicontrol(f,"style","text","string","MODEL RESULTS", ...
        "position",[950 775 450 30],"fontsize",14,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    results_frame = uicontrol(f,"style","frame","position",[940 575 470 190], ...
        "background",[0.12 0.13 0.19]);

    status_text = uicontrol(f,"style","text","string","STATUS: READY", ...
        "position",[965 710 420 30],"fontsize",12,"fontweight","bold", ...
        "foreground",[0.2 0.9 0.5],"background",[0.12 0.13 0.19],"horizontalalignment","left");
    accuracy_text = uicontrol(f,"style","text","string","Accuracy: --", ...
        "position",[965 665 420 30],"fontsize",13,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.12 0.13 0.19],"horizontalalignment","left");
    loss_text = uicontrol(f,"style","text","string","Final Loss: --", ...
        "position",[965 625 420 30],"fontsize",13, ...
        "foreground",[1 1 1],"background",[0.12 0.13 0.19],"horizontalalignment","left");
    epoch_text = uicontrol(f,"style","text","string","Epochs: 0", ...
        "position",[965 585 420 30],"fontsize",13, ...
        "foreground",[1 1 1],"background",[0.12 0.13 0.19],"horizontalalignment","left");

    uicontrol(f,"style","text","string","PREDICTION TABLE", ...
        "position",[950 535 450 30],"fontsize",14,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    prediction_table = uicontrol(f,"style","table", ...
        "string",["X1" "X2" "Actual" "Predicted" "Probability"; "-" "-" "-" "-" "-"; "-" "-" "-" "-" "-"; "-" "-" "-" "-" "-"; "-" "-" "-" "-" "-"], ...
        "position",[950 330 450 190],"fontsize",11);

    uicontrol(f,"style","text","string","LEARNING INSIGHT", ...
        "position",[950 280 450 30],"fontsize",14,"fontweight","bold", ...
        "foreground",[1 1 1],"background",[0.05 0.06 0.10]);

    insight_text = uicontrol(f,"style","text", ...
        "string","Choose a dataset and press TRAIN NETWORK.", ...
        "position",[950 100 450 165],"fontsize",11, ...
        "foreground",[1 1 1],"background",[0.12 0.13 0.19], ...
        "horizontalalignment","left");

    // ---------------- STORE HANDLES ----------------
    NEUROLAB_HANDLES.figure = f;
    NEUROLAB_HANDLES.dataset_menu = dataset_menu;
    NEUROLAB_HANDLES.learning_rate_input = learning_rate_input;
    NEUROLAB_HANDLES.epochs_input = epochs_input;
    NEUROLAB_HANDLES.hidden_input = hidden_input;
    NEUROLAB_HANDLES.train_button = train_button;
    NEUROLAB_HANDLES.reset_button = reset_button;
    NEUROLAB_HANDLES.inspect_button = inspect_button;
    NEUROLAB_HANDLES.math_button = math_button;
    NEUROLAB_HANDLES.loss_axes = loss_axes;
    NEUROLAB_HANDLES.network_axes = network_axes;
    NEUROLAB_HANDLES.status_text = status_text;
    NEUROLAB_HANDLES.accuracy_text = accuracy_text;
    NEUROLAB_HANDLES.loss_text = loss_text;
    NEUROLAB_HANDLES.epoch_text = epoch_text;
    NEUROLAB_HANDLES.prediction_table = prediction_table;
    NEUROLAB_HANDLES.insight_text = insight_text;

    // ---------------- CALLBACKS ----------------
    train_button.callback = "train_from_gui()";
    reset_button.callback = "reset_gui()";
    inspect_button.callback = "inspect_network()";
    math_button.callback = "show_math()";

    // ---------------- INITIAL AXES ----------------
    scf(f);
    sca(loss_axes);
    xtitle("Training Loss","Epoch","Loss");
    xgrid();

    sca(network_axes);
    xtitle("Neural Network Flow","Layer","Neuron position");
    a = gca();
    a.data_bounds = [0 0; 6 3.6];

    drawnow();
endfunction
